{
  "schemaVersion": 1,
  "id": "elijahrou.mullvad",
  "name": "Mullvad VPN",
  "version": "1.0.0",
  "author": "Elijah Roussos",
  "license": "MIT",
  "description": "Mullvad VPN status, connect, location, account, and settings in a native Omarchy bar panel.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Mullvad VPN",
    "description": "Connect or disconnect, pick a country or city, log in, and change tunnel, DNS, and lockdown settings.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Account refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      }
    ]
  }
}
